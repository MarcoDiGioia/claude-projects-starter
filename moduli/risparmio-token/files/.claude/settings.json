{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./.expo/**)",
      "Read(./android/build/**)",
      "Read(./android/app/build/**)",
      "Read(./.godot/**)",
      "Read(./package-lock.json)",
      "Read(./**/*.log)",
      "Read(./**/*.min.js)"
    ]
  }
}
